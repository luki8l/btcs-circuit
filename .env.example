# ---- pilot mode: Vercel + Supabase (sign-in with e-mail + password) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# server only, never expose: creates accounts and sign-in links
SUPABASE_SECRET_KEY=sb_secret_...
SITE_URL=https://<your-app>.vercel.app

# ---- Azure mode: any PostgreSQL + Microsoft sign-in (docs/HANDOVER.md) ----
# CIRCUIT_BACKEND=postgres
# SITE_URL=https://circuit.example.com
# DATABASE_URL=postgres://circuit_app:<password>@<server>.postgres.database.azure.com:5432/circuit?sslmode=verify-full
# CIRCUIT_SESSION_SECRET=<at least 32 random characters: openssl rand -base64 48>
# ENTRA_TENANT_ID=<directory (tenant) id>
# ENTRA_CLIENT_ID=<application (client) id>
# ENTRA_CLIENT_SECRET=<client secret value>
# CIRCUIT_SESSION_DAYS=30
# PGPOOL_MAX=5

# ---- optional, both modes: HubSpot (server only; mark as sensitive) ----
HUBSPOT_SERVICE_KEY=pat-...
# HUBSPOT_AUTO_SYNC=on
